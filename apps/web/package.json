{
  "name": "@agrocontrol/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:test": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build --webpack",
    "lint": "eslint .",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run test:contracts",
    "test:contracts": "node --import tsx --test src/lib/api-health.test.ts src/lib/api/contracts.test.ts src/app/login/actions.test.ts src/app/dashboard/catalog/actions.test.ts src/app/dashboard/stock/actions.test.ts src/app/dashboard/cash/actions.test.ts src/app/dashboard/pos/actions.test.ts src/app/dashboard/customers/actions.test.ts src/app/dashboard/fiscal/actions.test.ts",
    "test:components": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.541.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.1.6",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
