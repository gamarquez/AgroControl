# Production environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:$PORT
AllowedHosts=api.example.com
Cors__AllowedOrigins=https://app.example.com
NEXT_PUBLIC_APP_ENV=production
APP_TIMEZONE=America/Argentina/Buenos_Aires
AGROCONTROL_API_BASE_URL=https://api.example.com
API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_API_HEALTH_PATH=/health
POSTGRES_CONNECTION_STRING=Host=db.example.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=replace-me;SSL Mode=Require;Trust Server Certificate=true
SUPABASE_DB_CONNECTION_STRING=Host=db.example.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=replace-me;SSL Mode=Require;Trust Server Certificate=true
Auth__SigningKey=replace-me-with-a-long-random-secret
Auth__Issuer=https://api.example.com
Auth__Audience=https://app.example.com
NEXT_TELEMETRY_DISABLED=1
SUPABASE_URL=
SUPABASE_ANON_KEY=
